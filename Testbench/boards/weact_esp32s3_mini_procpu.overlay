/* Enable peripherals used by the testbench */
&spi2 {
    status = "okay";
};

&adc0 {
    status = "okay";
};

&adc1 {
    status = "okay";
};

&ledc0 {
    status = "okay";
};

&uart1 {
    status = "okay";
    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";
    current-speed = <115200>;
};
